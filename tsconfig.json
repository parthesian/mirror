{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022"],
        "strict": true,
        "noEmit": true,
        "allowJs": true,
        "checkJs": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "types": ["@cloudflare/workers-types"],
        "noUncheckedIndexedAccess": true
    },
    "include": ["shared/**/*.ts", "server/**/*.ts", "functions/**/*.ts", "tests/**/*.ts", "tests/**/*.d.ts"],
    "exclude": ["shared/browser.ts"]
}
